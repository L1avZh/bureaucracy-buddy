{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI 🐍",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--reload", "--port", "8000"]
    },
    {
      "name": "React (Vite) ▶",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
