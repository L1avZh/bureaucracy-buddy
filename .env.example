# Bureaucracy Buddy — environment variables
# Copy this file to .env (repo root) and/or backend/.env and fill in real values.
# See backend/CONTRACT.md and backend/README.md for details.

# ------------------------------------------------------------------
# Backend (FastAPI) — see backend/app/config.py
# ------------------------------------------------------------------

# development | production | test
ENVIRONMENT=development

# Required in production (fail-fast if unset and ENVIRONMENT=production).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# SQLite by default for local dev; use a postgresql+asyncpg:// URL in production
# (e.g. postgresql+asyncpg://buddy:buddy@localhost:5432/buddy).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Comma-separated list of allowed origins for CORS (credentials are only allowed for these).
CORS_ORIGINS=http://localhost:5173

# mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

MAX_UPLOAD_MB=10
STORAGE_DIR=./storage

# ------------------------------------------------------------------
# Frontend (Vite/React) — placeholder section, owned by the frontend engineer.
# Add VITE_-prefixed vars here as the frontend needs them (e.g. VITE_API_BASE_URL).
# ------------------------------------------------------------------
